-- Run in the Supabase SQL editor. Copy to 0001_visited_countries.sql and set your email first.

create table if not exists public.visited_countries (
  iso_numeric text primary key,           -- 3-digit, zero-padded, matches world-atlas ids
  iso_alpha3  text not null,
  name        text not null,
  visited_on  date,
  notes       text,
  created_at  timestamptz not null default now()
);

alter table public.visited_countries enable row level security;

-- Anyone can view the map.
create policy "public read" on public.visited_countries
  for select using (true);

-- Only the owner can edit.
create policy "owners insert" on public.visited_countries
  for insert with check ((auth.jwt() ->> 'email') = 'YOU@example.com');
create policy "owners update" on public.visited_countries
  for update using ((auth.jwt() ->> 'email') = 'YOU@example.com');
create policy "owners delete" on public.visited_countries
  for delete using ((auth.jwt() ->> 'email') = 'YOU@example.com');

-- API privileges (needed when "Automatically expose new tables" is off).
-- RLS above still decides which rows each role can touch.
grant select on public.visited_countries to anon, authenticated;
grant insert, update, delete on public.visited_countries to authenticated;
